# ==============================================================================
# L2H SOLUTION — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.

# Application Domain & Host
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database Configuration (Optional for SQLite/JSON, required for hosted PostgreSQL/MongoDB)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/l2h_production?schema=public"

# Admin Authentication & Session Secrets
ADMIN_EMAIL="admin@l2hsolution.com"
ADMIN_PASSWORD_HASH="pbkdf2_admin_secure_hash"
SESSION_SECRET="l2h-super-secret-jwt-signing-key-minimum-32-chars"

# WhatsApp Business Cloud API Integration
NEXT_PUBLIC_WHATSAPP_PHONE="+919876543210"
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Google Maps / Geospatial API
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# AI Concierge & Embeddings (Gemini / OpenAI)
AI_API_KEY=""
AI_MODEL_NAME="gemini-2.0-flash"

# CRM Webhooks (Salesforce / HubSpot / LeadSquared)
CRM_WEBHOOK_URL=""
CRM_API_KEY=""

# Transactional Email (SMTP / Resend / SendGrid)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="advisory@l2hsolution.com"
